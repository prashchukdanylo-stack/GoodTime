// use prisma-8
enum Gender {
  @@type("pg/text@1")
  Male   = "male"
  Female = "female"
  Other  = "other"
}

enum SessionStatus {
  @@type("pg/text@1")
  InProgress = "in_progress"
  Completed  = "completed"
  Abandoned  = "abandoned"
}

model Player {
  id        Uuid      @id @onCreate(uuid(7))
  username  String?
  email     String    @unique
  password  String
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  levels   PlayerLevelProgress[]
  sessions GameSession[]
  items    PlayerItem[]

  maleCharacterId   Uuid? @map("male_character_id")
  femaleCharacterId Uuid? @map("female_character_id")

  maleCharacter   Character? @relation("PlayerMaleCharacter", fields: [maleCharacterId], references: [id], onDelete: SetNull)
  femaleCharacter Character? @relation("PlayerFemaleCharacter", fields: [femaleCharacterId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("player")
}

model Level {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  title       String
  district    String
  totalRounds Int     @map("total_rounds")
  isActive    Boolean @default(true) @map("is_active")

  sessions GameSession[]
  progress PlayerLevelProgress[]
  items    Item[]

  @@check(expression: sql`total_rounds >= 1`, name: "level_total_rounds_positive")
  @@map("level")
}

model GameSession {
  id              Uuid          @id @onCreate(uuid(7))
  playerId        Uuid          @map("player_id")
  levelId         Int           @map("level_id")
  status          SessionStatus @default(InProgress)
  roundsCompleted Int           @default(0) @map("rounds_completed")
  won             Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@index([playerId, levelId])
  @@index([levelId, createdAt])
  @@check(expression: sql`rounds_completed >= 0`, name: "game_session_rounds_not_negative")
  @@map("game_session")
}

model PlayerLevelProgress {
  id              Uuid     @id @onCreate(uuid(7))
  playerId        Uuid     @map("player_id")
  levelId         Int      @map("level_id")
  maxRoundReached Int      @default(0) @map("max_round_reached")
  isCompleted     Boolean  @default(false) @map("is_completed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  level  Level  @relation(fields: [levelId], references: [id], onDelete: Restrict)

  @@unique([playerId, levelId])
  @@check(expression: sql`max_round_reached >= 0`, name: "progress_max_round_not_negative")
  @@map("player_level_progress")
}

model Item {
  id          Uuid   @id @onCreate(uuid(7))
  levelId     Int?   @map("level_id")
  name        String @unique
  description String

  level   Level?       @relation(fields: [levelId], references: [id], onDelete: SetNull)
  players PlayerItem[]

  @@map("item")
}

model PlayerItem {
  id         Uuid     @id @onCreate(uuid(7))
  playerId   Uuid     @map("player_id")
  itemId     Uuid     @map("item_id")
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now()) @map("acquired_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([playerId, itemId])
  @@index([playerId])
  @@check(expression: sql`quantity > 0`, name: "player_item_quantity_positive")
  @@map("player_item")
}

model Character {
  id          Uuid   @id @onCreate(uuid(7))
  name        String @unique
  gender      Gender
  description String

  malePlayers   Player[] @relation("PlayerMaleCharacter")
  femalePlayers Player[] @relation("PlayerFemaleCharacter")

  @@map("character")
}